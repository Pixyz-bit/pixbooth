{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/templates",
      "destination": "/templates.html"
    },
    {
      "source": "/booth",
      "destination": "/booth.html"
    },
    {
      "source": "/edit",
      "destination": "/edit.html"
    }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/templates.html", "destination": "/templates", "permanent": true },
    { "source": "/booth.html", "destination": "/booth", "permanent": true },
    { "source": "/edit.html", "destination": "/edit", "permanent": true }
  ]
}
